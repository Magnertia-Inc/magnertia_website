# Copy this file to server/.env for local development. Never commit real values.

# MongoDB Atlas connection string (Atlas → Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/magnertia?retryWrites=true&w=majority

# Port the Express server listens on (Railway sets this automatically)
PORT=4000

# Allowed frontend origin(s) for CORS, comma separated
CORS_ORIGIN=http://localhost:5173

# Admin dashboard login (/login). Use a strong password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Random secret used to sign admin sessions, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
