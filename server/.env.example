# Copy this file to server/.env for local development. Never commit real values.

# PostgreSQL connection string. On Railway this is ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/magnertia
# Set to true only if your Postgres host requires SSL (Railway's private network does not).
DATABASE_SSL=false

# Port the Express server listens on
PORT=4000

# Allowed frontend origin(s) for CORS, comma separated
CORS_ORIGIN=http://localhost:5173

# Random secret used to sign admin sessions, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Admin dashboard login (/login). On startup the API creates this admin in the
# database (or resets its password). Password: at least 10 characters.
# You can remove both variables after the first successful deploy.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
